# Focus Agent 环境变量
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 也可用操作系统环境变量提供同名键（优先级高于本文件，无需新建文件）:
#   Windows:      setx OPENAI_API_KEY "sk-..."
#   macOS/Linux:  export OPENAI_API_KEY=sk-...

# 模型密钥（必填）—— config.yaml 中所有模型条目均引用它
OPENAI_API_KEY=sk-your-api-key-here

# 以下为可选覆盖项，按需取消注释
# 默认模型：取 config.yaml models 中已存在的条目名（覆盖条目上的 default: true 声明）
#FOCUS_MODEL=deepseek-v4-flash
# 数据库连接（默认使用 desktop/compose.yaml 提供的本地 PostgreSQL）
#FOCUS_DATABASE_URL=postgresql+asyncpg://focus:qweasdzxc123@127.0.0.1:7221/focus
