{
  "name": "focus-desktop-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Focus 全图巡逻小兵桌面 PoC",
  "main": "src/main/main.cjs",
  "scripts": {
    "build:browser": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-browser.ps1",
    "prepare:browser": "node scripts/prepare-browser.cjs",
    "prestart": "npm run prepare:browser",
    "build:patrol-editor": "node scripts/build-patrol-editor.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:native": "node --test src/main/windows-sandbox/native.test.mjs",
    "start": "electron .",
    "install:electron": "install-electron",
    "dev": "cd .. && python -m uvicorn backend.app.gateway.app:app --host 127.0.0.1 --port 8765"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron": "^43.2.0",
    "koffi": "3.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "esbuild": "^0.28.2"
  }
}
